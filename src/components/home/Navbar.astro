---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { HomeCopy, Locale } from '../../data/home';
import Button from '../Button.astro';

interface Props {
	locale: Locale;
	copy: HomeCopy;
}

const { locale, copy } = Astro.props;
const ptHref = getRelativeLocaleUrl('pt-br');
const enHref = getRelativeLocaleUrl('en');
---

<a class="skip-link" href="#conteudo">{copy.nav.skipToContent}</a>
<header class="navbar">
	<div class="container">
		<a class="brand" href="#topo" aria-label={copy.nav.brandAria}><strong>daniel.</strong>fagundes_</a>
		<nav class="nav-menu" id="nav-menu" aria-label={copy.nav.menuAria}>
			{
				copy.nav.links.map((link) => (
					<a class="nav-link" href={link.href}>
						<span class="nav-link-text">{link.label}</span>
						<span class="nav-link-text absolute">{link.label}</span>
					</a>
				))
			}
			<div class="nav-menu-foot">
				<nav class="lang-switch" aria-label={copy.nav.langAria}>
					<a href={ptHref} aria-current={locale === 'pt-br' ? 'true' : undefined}>PT</a>
					<span aria-hidden="true">/</span>
					<a href={enHref} aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
				</nav>
				<Button href="#contato">{copy.hero.contactCta}</Button>
			</div>
		</nav>
		<div class="row tight">
			<nav class="lang-switch nav-lang-bar" aria-label={copy.nav.langAria}>
				<a href={ptHref} aria-current={locale === 'pt-br' ? 'true' : undefined}>PT</a>
				<span aria-hidden="true">/</span>
				<a href={enHref} aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
			</nav>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label={copy.nav.themeToggle}>
				<svg
					class="icon-sun"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
				</svg>
				<svg
					class="icon-moon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"></path>
				</svg>
			</button>
			<button
				class="menu-toggle"
				type="button"
				data-menu-toggle
				aria-expanded="false"
				aria-controls="nav-menu"
				aria-label={copy.nav.menuOpen}
				data-label-open={copy.nav.menuOpen}
				data-label-close={copy.nav.menuClose}
			>
				<span class="menu-toggle-bar" aria-hidden="true"></span>
				<span class="menu-toggle-bar" aria-hidden="true"></span>
			</button>
		</div>
	</div>
</header>
