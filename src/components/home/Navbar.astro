---
import { navLinks } from '../../data/home';
---

<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
<header class="navbar">
	<div class="container">
		<a class="brand" href="#topo" aria-label="Daniel Fagundes, início"><strong>daniel.</strong>fagundes_</a>
		<nav class="nav-menu" aria-label="Navegação principal">
			{
				navLinks.map((link) => (
					<a class:list={['nav-link', { 'nav-optional': link.optional }]} href={link.href}>
						<span class="nav-link-text">{link.label}</span>
						<span class="nav-link-text absolute">{link.label}</span>
					</a>
				))
			}
		</nav>
		<div class="row tight">
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Alternar tema">
				<svg
					class="icon-sun"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
				</svg>
				<svg
					class="icon-moon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"></path>
				</svg>
			</button>
		</div>
	</div>
</header>
