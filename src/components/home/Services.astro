---
import { sectionIndex } from '../../data/home';
import type { HomeCopy } from '../../data/home';
import SectionHeading from './SectionHeading.astro';
import ServiceItem from './ServiceItem.astro';

interface Props {
	copy: HomeCopy;
}

const { copy } = Astro.props;
---

<section class="main-section tight" id="servicos">
	<div class="container stack">
		<div class="section-head">
			<SectionHeading index="02" title={copy.services.title} />
			<p class="section-lead fade-up">{copy.services.lead}</p>
		</div>
		<div class="stack tight">
			{copy.services.items.map((service, i) => (
				<ServiceItem
					service={service}
					index={sectionIndex(i)}
					viewLabel={copy.services.view}
					closeLabel={copy.services.close}
				/>
			))}
		</div>
	</div>
</section>
