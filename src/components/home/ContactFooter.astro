---
import Button from '../Button.astro';
import type { HomeCopy } from '../../data/home';

interface Props {
	copy: HomeCopy;
}

const { copy } = Astro.props;
---

<footer class="main-section close" id="contato">
	<div class="container stack">
		<div class="row tight fade-up">
			<div class="square-tag pulsing"></div>
			<span class="section-index">{copy.contact.eyebrow}</span>
		</div>
		<h2 class="close-title">
			<span class="stroke-text" data-stroke-text>
				<span class="stroke-text__label">{copy.contact.title}</span>
			</span>
			<span class="close-title-soft fade-up">{copy.contact.titleSoft}</span>
		</h2>
		<p class="section-lead fade-up">
			{copy.contact.lead}
		</p>
		<form class="contact-form stack" data-static method="post" onsubmit="return false">
			<div class="grid cols-2">
				<div class="field fade-up">
					<label class="field-label" for="contact-name">{copy.contact.form.nameLabel}</label>
					<input
						class="input"
						id="contact-name"
						name="name"
						type="text"
						autocomplete="name"
						placeholder={copy.contact.form.namePlaceholder}
					/>
				</div>
				<div class="field fade-up">
					<label class="field-label" for="contact-email">{copy.contact.form.emailLabel}</label>
					<input
						class="input"
						id="contact-email"
						name="email"
						type="email"
						autocomplete="email"
						placeholder={copy.contact.form.emailPlaceholder}
					/>
				</div>
			</div>
			<div class="field fade-up">
				<label class="field-label" for="contact-message">{copy.contact.form.messageLabel}</label>
				<textarea
					class="text-area"
					id="contact-message"
					name="message"
					placeholder={copy.contact.form.messagePlaceholder}
				></textarea>
			</div>
			<div class="row close-actions fade-up">
				<Button type="submit">{copy.contact.cta}</Button>
			</div>
		</form>
		<nav class="row close-channels fade-up" aria-label={copy.contact.channelsAria}>
			{
				copy.contact.channels.map((channel) => (
					<a
						class="text-link-social"
						href={channel.href}
						target={channel.external ? '_blank' : undefined}
						rel={channel.external ? 'noopener noreferrer' : undefined}
					>
						[ {channel.label} ]
					</a>
				))
			}
		</nav>
		<div class="horizontal-line line-draw"></div>
		<div class="row close-foot fade-up">
			<div class="row tight">
				<div class="square-tag"></div>
				<span class="section-index">{copy.contact.name}</span>
			</div>
			<a class="link" href="#topo">{copy.contact.backToTop}<span class="link-underline"></span></a>
		</div>
	</div>
</footer>
