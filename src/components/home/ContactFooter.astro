---
import Button from '../Button.astro';
import { channels, contact, site } from '../../data/home';
---

<footer class="main-section close" id="contato">
	<div class="container stack">
		<div class="row tight fade-up">
			<div class="square-tag pulsing"></div>
			<span class="section-index">{contact.eyebrow}</span>
		</div>
		<h2 class="close-title">
			<span class="stroke-text" data-stroke-text>
				<span class="stroke-text__label">{contact.title}</span>
			</span>
			<span class="close-title-soft fade-up">{contact.titleSoft}</span>
		</h2>
		<p class="section-lead fade-up">
			{contact.lead}
		</p>
		<div class="row close-actions fade-up">
			<Button href={`mailto:${site.email}`}>{contact.cta}</Button>
		</div>
		<nav class="row close-channels fade-up" aria-label="Canais">
			{
				channels.map((channel) => (
					<a
						class="text-link-social"
						href={channel.href}
						target={channel.external ? '_blank' : undefined}
						rel={channel.external ? 'noopener noreferrer' : undefined}
					>
						[ {channel.label} ]
					</a>
				))
			}
		</nav>
		<div class="horizontal-line line-draw"></div>
		<div class="row close-foot fade-up">
			<div class="row tight">
				<div class="square-tag"></div>
				<span class="section-index">{contact.name}</span>
			</div>
			<a class="link" href="#topo">{contact.backToTop}<span class="link-underline"></span></a>
		</div>
	</div>
</footer>
