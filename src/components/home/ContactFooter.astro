---
import Button from '../Button.astro';
import type { HomeCopy } from '../../data/home';

interface Props {
	copy: HomeCopy;
}

const { copy } = Astro.props;
const form = copy.contact.form;
---

<footer class="main-section close" id="contato">
	<div class="container stack">
		<div class="row tight fade-up">
			<div class="square-tag pulsing"></div>
			<span class="section-index">{copy.contact.eyebrow}</span>
		</div>
		<h2 class="close-title">
			<span class="stroke-text" data-stroke-text>
				<span class="stroke-text__label">{copy.contact.title}</span>
			</span>
			<span class="close-title-soft fade-up">{copy.contact.titleSoft}</span>
		</h2>
		<p class="section-lead fade-up">
			{copy.contact.lead}
		</p>
		<form
			class="contact-form stack"
			data-contact-form
			data-lang={copy.htmlLang}
			data-msg-name-required={form.nameRequired}
			data-msg-email-invalid={form.emailInvalid}
			data-msg-message-required={form.messageRequired}
			data-msg-network={form.networkError}
			data-label-sending={form.sending}
			method="post"
			novalidate
			onsubmit="return false"
		>
			<div class="grid cols-2">
				<div class="field fade-up">
					<label class="field-label" for="contact-name">{form.nameLabel}</label>
					<input
						class="input"
						id="contact-name"
						name="nome"
						type="text"
						autocomplete="name"
						aria-required="true"
						aria-describedby="contact-name-error"
						placeholder={form.namePlaceholder}
					/>
					<p class="field-error" id="contact-name-error" hidden></p>
				</div>
				<div class="field fade-up">
					<label class="field-label" for="contact-email">{form.emailLabel}</label>
					<input
						class="input"
						id="contact-email"
						name="email"
						type="email"
						autocomplete="email"
						aria-describedby="contact-email-error"
						placeholder={form.emailPlaceholder}
					/>
					<p class="field-error" id="contact-email-error" hidden></p>
				</div>
			</div>
			<div class="field fade-up">
				<label class="field-label" for="contact-message">{form.messageLabel}</label>
				<textarea
					class="text-area"
					id="contact-message"
					name="mensagem"
					aria-required="true"
					aria-describedby="contact-message-error"
					placeholder={form.messagePlaceholder}
				></textarea>
				<p class="field-error" id="contact-message-error" hidden></p>
			</div>
			<div class="row close-actions fade-up">
				<Button type="submit">{copy.contact.cta}</Button>
			</div>
			<p class="contact-form-status" data-contact-status role="status" aria-live="polite" hidden></p>
		</form>
		<nav class="row close-channels fade-up" aria-label={copy.contact.channelsAria}>
			{
				copy.contact.channels.map((channel) => (
					<a
						class="text-link-social"
						href={channel.href}
						target={channel.external ? '_blank' : undefined}
						rel={channel.external ? 'noopener noreferrer' : undefined}
						data-track={`social_${channel.id}`}
					>
						[ {channel.label} ]
					</a>
				))
			}
		</nav>
		<div class="horizontal-line line-draw"></div>
		<div class="row close-foot fade-up">
			<div class="row tight">
				<div class="square-tag"></div>
				<span class="section-index">{copy.contact.name}</span>
			</div>
			<a class="link" href="#topo">{copy.contact.backToTop}<span class="link-underline"></span></a>
		</div>
	</div>
</footer>
