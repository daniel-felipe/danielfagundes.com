---
import type { MarqueeItem } from '../../data/home';

interface Props {
	items: MarqueeItem[];
}

const { items } = Astro.props;
---

<section class="marquee" aria-hidden="true">
	{
		[0, 1].map(() => (
			<div class="marquee-track">
				{items.map((item) => (
					<p class:list={['marquee-text', { outline: item.outline }]}>{item.label}</p>
				))}
			</div>
		))
	}
</section>
