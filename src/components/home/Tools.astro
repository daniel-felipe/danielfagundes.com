---
import type { HomeCopy } from '../../data/home';
import SectionHeading from './SectionHeading.astro';

interface Props {
	copy: HomeCopy;
}

const { copy } = Astro.props;
---

<section class="main-section" id="ferramentas">
	<div class="container stack">
		<div class="section-head">
			<SectionHeading index="03" title={copy.tools.title} />
		</div>
		<div class="grid cols-3">
			{
				copy.tools.groups.map((group) => (
					<div class="card outline padded scale-in stack tight">
						<div class="spec">
							<h3 class="spec-label">{group.label}</h3>
						</div>
						<div class="row tight">
							{group.tags.map((tag) => (
								<span class="tag-service">{tag}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
