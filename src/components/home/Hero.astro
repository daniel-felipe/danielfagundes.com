---
import Button from '../Button.astro';
import type { HomeCopy } from '../../data/home';

interface Props {
	copy: HomeCopy;
}

const { copy } = Astro.props;
---

<section class="main-section hero" id="topo">
	<div class="hero-threads" aria-hidden="true"></div>
	<div class="container stack">
		<h1 class="hero-name">
			<span class="perspective"><span class="perspective-load">{copy.hero.firstName}</span></span>
			<span class="perspective"><span class="perspective-load hero-surname">{copy.hero.lastName}</span></span>
		</h1>
		<div class="hero-copy stack">
			<div class="hero-intro stack tight">
				<p class="section-lead fade-up">
					{copy.hero.p1}
				</p>
				<p class="section-lead fade-up">
					{copy.hero.p2}
				</p>
				<p class="section-lead fade-up">
					<a class="link" href="#projetos">{copy.hero.workLink}<span class="link-underline"></span></a>
				</p>
			</div>
			<div class="row hero-actions fade-up">
				<Button href="#contato" data-track="contact_cta" data-track-location="hero">
					{copy.hero.contactCta}
				</Button>
				<Button variant="secondary" href={copy.github} external data-track="github_cta">
					{copy.hero.githubCta}
				</Button>
			</div>
		</div>
	</div>
</section>
