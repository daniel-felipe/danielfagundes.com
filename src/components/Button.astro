---
interface Props {
	variant?: 'primary' | 'secondary';
	size?: 'small' | 'large';
	fullWidth?: boolean;
	href?: string;
	external?: boolean;
	type?: 'button' | 'submit' | 'reset';
	disabled?: boolean;
	class?: string;
	'data-track'?: string;
	'data-track-location'?: string;
}

const {
	variant = 'primary',
	size,
	fullWidth = false,
	href,
	external = false,
	type = 'button',
	disabled = false,
	class: className,
	'data-track': dataTrack,
	'data-track-location': dataTrackLocation,
} = Astro.props;

const classes = [`button-${variant}`, size, fullWidth && 'full-width', className];
const trackAttrs = {
	'data-track': dataTrack,
	'data-track-location': dataTrackLocation,
};
---

{
	href ? (
		<a
			class:list={classes}
			href={href}
			target={external ? '_blank' : undefined}
			rel={external ? 'noopener noreferrer' : undefined}
			{...trackAttrs}
		>
			<span class="button-fx" aria-hidden="true"></span>
			<span class="button-label"><slot /></span>
		</a>
	) : (
		<button class:list={classes} type={type} disabled={disabled || undefined} {...trackAttrs}>
			<span class="button-fx" aria-hidden="true"></span>
			<span class="button-label"><slot /></span>
		</button>
	)
}
