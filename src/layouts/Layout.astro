---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import type { HomeCopy, Locale } from '../data/home';
import '../styles/global.css';
import fontsRestHref from '../styles/fonts-rest.css?url';

interface Props {
	locale: Locale;
	copy: HomeCopy;
}

const { locale, copy } = Astro.props;
const { title, description, jobTitle, ogImageAlt } = copy.meta;
const htmlLang = copy.htmlLang;

const ptUrl = getAbsoluteLocaleUrl('pt-br');
const enUrl = getAbsoluteLocaleUrl('en');
const canonical = getAbsoluteLocaleUrl(locale);
const siteOrigin = (Astro.site ?? new URL('https://danielfagundes.com')).origin;
const ogImage = new URL('/og.jpg', siteOrigin).href;
const ogLocale = locale === 'en' ? 'en_US' : 'pt_BR';
const ogLocaleAlternate = locale === 'en' ? 'pt_BR' : 'en_US';

const sameAs = copy.contact.channels.filter((channel) => channel.external).map((channel) => channel.href);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteOrigin}/#website`,
			url: ptUrl,
			name: copy.contact.name,
			inLanguage: ['pt-BR', 'en'],
			publisher: { '@id': `${siteOrigin}/#person` },
		},
		{
			'@type': 'Person',
			'@id': `${siteOrigin}/#person`,
			name: copy.contact.name,
			jobTitle,
			url: canonical,
			email: copy.email,
			sameAs,
			worksFor: { '@type': 'Organization', name: 'DevStats' },
			knowsAbout: [
				'Laravel',
				'React',
				'PHP',
				'Python',
				'n8n',
				'PostgreSQL',
				'API integration',
				'Web applications',
			],
		},
		{
			'@type': 'FAQPage',
			'@id': `${canonical}#faq`,
			url: `${canonical}#faq`,
			mainEntity: copy.faq.items.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.answer,
				},
			})),
		},
	],
};
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZCN8EVQM2L"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-ZCN8EVQM2L');
		</script>
		<!-- Google Tag Manager -->
		<script is:inline>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', 'GTM-W4BZWHCG');
		</script>
		<!-- End Google Tag Manager -->
		<meta name="color-scheme" content="dark light" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c0c" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7ff" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Daniel F." />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={copy.contact.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlternate} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="alternate" hreflang="pt-BR" href={ptUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={ptUrl} />
		<title>{title}</title>
		<link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="stylesheet" href={fontsRestHref} media="print" onload="this.media='all'" />
		{/* Must run before paint: .w-mod-js / theme to avoid flash */}
		<script is:inline src="/scripts/boot.js"></script>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript>
			<iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-W4BZWHCG"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe>
		</noscript>
		<!-- End Google Tag Manager (noscript) -->
		<slot />
	</body>
</html>
