---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	htmlLang: string;
}

const { title, description, htmlLang } = Astro.props;
const ptUrl = getAbsoluteLocaleUrl('pt-br');
const enUrl = getAbsoluteLocaleUrl('en');
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="alternate" hreflang="pt-BR" href={ptUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={ptUrl} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Manrope:wght@200..800&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
			rel="stylesheet"
		/>
		{/* Must run before paint: .w-mod-js / theme to avoid flash */}
		<script is:inline src="/scripts/boot.js"></script>
	</head>
	<body>
		<slot />
	</body>
</html>
